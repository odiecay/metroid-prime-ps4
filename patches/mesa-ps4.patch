+   if (capacity) *capacity = 0;
+   if (after) *after = 0;
+   if (polls) *polls = 0;
+   pthread_mutex_lock(&prime_scanout_mutex);
+   struct wsi_orbis_scanout *so = NULL;
+   unsigned count = 0;
