+static void
+orbis_copy_options_init(void)
+{
+   const char *bulk = getenv("ORBIS_BULK_PACKET_COPY");
+   orbis_copy_bulk = !(bulk && !strcmp(bulk, "0"));
+   orbis_copy_break_chains = getenv("ORBIS_SELFTEST_BREAK") != NULL;
+   const char *validate = getenv("ORBIS_VALIDATE_SUBMITS");
+   orbis_validate_submits = validate && !strcmp(validate, "1");
+   mesa_logw("orbis-drm: native packet-copy=%s validation=%s (shader/GPU/resource semantics unchanged)",
+             orbis_copy_bulk ? "bulk-runs" : "legacy", orbis_validate_submits ? "on" : "off");
+}
+
+static uint32_t *
+orbis_copy_packet_run(uint32_t *dst, const uint32_t *dst_end, const uint32_t *src, uint32_t words)
+{
+   if (words > (size_t)(dst_end - dst))
+      return NULL;
+   if (words)
+      memcpy(dst, src, (size_t)words * sizeof(*src));
+   return dst + words;
+}
+
+static uint32_t *
+orbis_copy_ib_bulk(uint32_t *dst, const uint32_t *dst_end, const uint32_t *src, uint32_t n,
+                   unsigned depth, unsigned *chains)
+{
+   uint32_t run = 0;
+   for (uint32_t i = 0; i < n;) {
+      const uint32_t hdr = src[i];
+      if (hdr == 0)
+         return orbis_copy_packet_run(dst, dst_end, src + run, i - run);
+      if ((hdr & 0xc0000000u) != 0xc0000000u)
+         return orbis_copy_packet_run(dst, dst_end, src + run, n - run);
+      const uint32_t op = (hdr >> 8) & 0xffu;
+      const uint32_t words = 2u + ((hdr >> 16) & 0x3fffu);
+      if (op == 0x10 && words > n - i) {
+         dst = orbis_copy_packet_run(dst, dst_end, src + run, i - run);
+         if (!dst)
+            return NULL;
+         run = ++i;
+         continue;
+      }
+      if (words > n - i)
+         return orbis_copy_packet_run(dst, dst_end, src + run, n - run);
+      if (op == 0x3f && words >= 4 && (src[i + 3] & (1u << 20)) && !orbis_copy_break_chains) {
+         const uint64_t addr = (uint64_t)src[i + 1] | ((uint64_t)(src[i + 2] & 0xffffu) << 32);
+         const uint32_t size_dw = src[i + 3] & 0xfffffu;
+         if (depth >= ORBIS_CHAIN_MAX_DEPTH) {
+            mesa_loge("orbis-drm: chain deeper than %d - REFUSING the submission rather than emitting a chain "
+                      "packet the fence cannot survive", ORBIS_CHAIN_MAX_DEPTH);
+            return NULL;
+         }
+         if (size_dw == 0 || addr < orbis_va_base || addr + (uint64_t)size_dw * 4 > orbis_va_end) {
+            mesa_logw("orbis-drm: chain target 0x%" PRIx64 " (%u dw) is outside the arena - not flattened",
+                      addr, size_dw);
+         } else {
+            dst = orbis_copy_packet_run(dst, dst_end, src + run, i - run);
+            if (!dst)
+               return NULL;
+            ++*chains;
+            return orbis_copy_ib_bulk(dst, dst_end, (const uint32_t *)(uintptr_t)addr, size_dw,
+                                      depth + 1, chains);
+         }
+      }
+      i += words;
+   }
+   return orbis_copy_packet_run(dst, dst_end, src + run, n - run);
+}
