@@ -247,8 +247,19 @@ namespace LibOrbisPkg.PFS
       {
         if (!hdr.Mode.HasFlag(PfsMode.Signed))
         {
-          throw new Exception("Unsigned PFS images probably shouldn't have noncontiguous blocks");
+          // The unsigned builder explicitly lists the contiguous blocks of
+          // flat_path_table and collision_resolver. A sufficiently large file
+          // catalog crosses one block even though normal data inodes use a
+          // start block followed by -1 sentinels. Verify that complete extent
+          // before using the contiguous reader; do not accept fragmentation.
+          if (dinodes[dinode].Blocks > 12)
+            throw new Exception("Unsupported unsigned explicit block extent");
+          for (var i = 1; i < dinodes[dinode].Blocks; ++i)
+            if (dinodes[dinode].DirectBlocks[i] != dinodes[dinode].StartBlock + i)
+              throw new Exception("Noncontiguous unsigned PFS block extent");
         }
+        else
+        {
         blocks = new int[dinodes[dinode].Blocks];
         var remainingBlocks = (long)dinodes[dinode].Blocks;
         var sigsPerBlock = hdr.BlockSize / 36;
@@ -287,6 +298,7 @@ namespace LibOrbisPkg.PFS
         }
         if (contiguous)
           blocks = null;
+        }
       }
       return new File(reader)
