+namespace aurora::gx::fifo::draw_profile {
+// Decoder-owned, allocation-free sampled CPU-preparation timings. The producer
+// takes a snapshot only after the existing decoder drain has completed.
+using Clock = uint64_t (*)() noexcept;
+constexpr uint64_t Unavailable = std::numeric_limits<uint64_t>::max();
+enum Stage : uint8_t { VertexIndex, Arrays, Config, Pipeline, Textures, BindGroups, Uniforms, Recording, StageCount };
+struct Frame {
+  uint64_t draws=0, samples=0, earlyReturns=0, wallNs=0, cpuNs=0, cpuSamples=0;
+  uint64_t wallClockReads=0, cpuClockReads=0, invalidWall=0;
+  std::array<uint64_t,StageCount> stages{};
+};
+struct Metrics {
+  Frame frame;
+  uint32_t ordinal=0, phase=0;
+  bool select(bool enabled) noexcept {
+    if (!enabled) return false;
+    ++frame.draws;
+    // Rotate through all positions in each 64-draw block across 64 frames,
+    // avoiding a permanent bias toward the same material/pass ordinal.
+    return (ordinal++ & 63u) == phase;
+  }
+  Frame take_frame() noexcept {
+    Frame out=frame;
+    frame={};ordinal=0;phase=(phase+37u)&63u;
+    return out;
+  }
+};
+class Draw {
+  Frame* frame_=nullptr;
+  Clock wall_=nullptr,cpu_=nullptr;
+  uint64_t start_=0,since_=0,cpuStart_=Unavailable;
+  Stage stage_=VertexIndex;
+  bool complete_=false;
+  uint64_t wall_now() noexcept {++frame_->wallClockReads;return wall_();}
+  void close_stage(uint64_t now) noexcept {
+    if (now>=since_) frame_->stages[stage_]+=now-since_;
+    else ++frame_->invalidWall;
+    since_=now;
+  }
+public:
+  Draw(Metrics& metrics,bool enabled,Clock wall,Clock cpu=nullptr) noexcept {
+    if (!metrics.select(enabled)) return;
+    frame_=&metrics.frame;wall_=wall;cpu_=cpu;
+    ++frame_->samples;
+    // Optional per-draw CPU queries are outside the wall-stage partition. The
+    // CPU interval surrounds wall time and includes additional observer work;
+    // whole FIFO batches provide the less intrusive worker CPU measurement.
+    if (cpu_) {++frame_->cpuClockReads;cpuStart_=cpu_();}
+    start_=since_=wall_now();
+  }
+  ~Draw() {
+    if (!frame_) return;
+    const auto now=wall_now();
+    uint64_t cpuEnd=Unavailable;
+    if (cpu_) {++frame_->cpuClockReads;cpuEnd=cpu_();}
+    close_stage(now);
+    if (now>=start_) frame_->wallNs+=now-start_;
+    else ++frame_->invalidWall;
+    if (!complete_) ++frame_->earlyReturns;
+    if (cpuStart_!=Unavailable && cpuEnd!=Unavailable && cpuEnd>=cpuStart_) {
+      frame_->cpuNs+=cpuEnd-cpuStart_;++frame_->cpuSamples;
+    }
+  }
+  Draw(const Draw&)=delete;
+  Draw& operator=(const Draw&)=delete;
+  void stage(Stage next) noexcept {
+    if (!frame_ || next==stage_) return;
+    close_stage(wall_now());stage_=next;
+  }
+  void complete() noexcept {complete_=true;}
+};
+} // namespace aurora::gx::fifo::draw_profile
