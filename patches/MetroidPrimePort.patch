@@ -0,0 +1,30 @@
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+namespace aurora::gfx {
+// Producer-local, bounded and non-owning. Collisions merely repeat preparation;
+// a room change or cache reset must never suppress recording a pipeline use.
+struct PipelinePrepareMemo {
+  struct Entry {
+    uint64_t hash = 0;
+    uint64_t context = 0;
+    uint64_t epoch = 0;
+  };
+  std::array<Entry, 512> entries{};
+
+  bool contains(uint64_t hash, uint64_t context, uint64_t epoch) const noexcept {
+    const auto& entry = entries[index(hash, context)];
+    return epoch != 0 && entry.epoch == epoch && entry.hash == hash && entry.context == context;
+  }
+  void remember(uint64_t hash, uint64_t context, uint64_t epoch) noexcept {
+    entries[index(hash, context)] = {hash, context, epoch};
+  }
+private:
+  static std::size_t index(uint64_t hash, uint64_t context) noexcept {
+    return (hash ^ (context * UINT64_C(0x9e3779b97f4a7c15))) & 511;
+  }
+};
+} // namespace aurora::gfx
