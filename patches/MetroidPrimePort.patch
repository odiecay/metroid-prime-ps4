+// and the complete destination span. Emit two triangles per iteration.
+static u16* write_prepared_strip(u16* out, u16 base, u16 count) noexcept {
+  *out++ = base;
+  *out++ = u16(base + 1);
+  *out++ = u16(base + 2);
+  u32 v = 3;
