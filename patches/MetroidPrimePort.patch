--- /dev/null
+++ b/platform/port_startup.cpp
@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: MIT
+// Startup diagnostics only. The system artwork remains until the game's
+// ordinary first frame; this helper owns no UI, frame, input or GPU resource.
+#include "port_startup.h"
+
+#if defined(__ORBIS__)
+#include "port_log.h"
+#include <SDL3/SDL_timer.h>
+#include <cstdint>
+#include <cstring>
+
+namespace PortStartup {
+namespace {
+bool sActive = false;
+uint64_t sBegan = 0;
+uint64_t sStageBegan = 0;
+char sStage[96] = "Preparing graphics";
+} // namespace
+
+void Begin() {
+  sActive = true;
+  sBegan = sStageBegan = SDL_GetTicksNS();
+  std::snprintf(sStage, sizeof(sStage), "%s", "Preparing graphics");
+  PortLog::Write("port: startup: preparing graphics; monotonic_ns=%llu\n",
+                 static_cast<unsigned long long>(sBegan));
+}
+
+void Stop() { sActive = false; }
+
+void Stage(const char* name) {
+  if (!sActive || name == nullptr || std::strcmp(sStage, name) == 0) {
+    return;
+  }
+  const uint64_t now = SDL_GetTicksNS();
+  PortLog::Write("port: startup: %s -> %s; stage %.1f ms, total %.1f ms\n", sStage, name,
+                 static_cast<double>(now - sStageBegan) / 1000000.0,
+                 static_cast<double>(now - sBegan) / 1000000.0);
+  sStageBegan = now;
+  std::snprintf(sStage, sizeof(sStage), "%s", name);
+}
+} // namespace PortStartup
+#endif
