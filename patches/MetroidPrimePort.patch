+    for (unsigned i = 0; i < arrays[a].size(); ++i) arrays[a][i] = u8(a * 31 + i);
+  std::vector<u8> bytes;
+  const auto be = [&](uint64_t value, unsigned size) {
+    for (unsigned n = size; n != 0; --n) bytes.push_back(u8(value >> ((n - 1) * 8)));
+  };
+  constexpr unsigned packets = 4096;
+  for (unsigned i = 0; i < packets; ++i) {
+    const auto* data = arrays[i % arrays.size()].data();
+    bytes.push_back(GX_AURORA); be(GX_AURORA_LOAD_ARRAYBASE + (GX_VA_TEX0 - GX_VA_POS), 2);
+    be(reinterpret_cast<uintptr_t>(data), 8); be(arrays[0].size(), 4); be(i & 1, 1);
+    bytes.push_back(GX_AURORA); be(GX_AURORA_LOAD_TEXOBJ, 2);
+    be(0, 1); be(reinterpret_cast<uintptr_t>(data), 8);
+    be(reinterpret_cast<uintptr_t>(arrays[(i + 3) % arrays.size()].data()), 8);
+    be(32 + i % 64, 4); be(64 + i % 128, 4); be(GX_TF_RGBA8, 4); be(GX_TLUT0, 4);
+    be(i & 1, 1); be(0x90000000u + i, 4); be(0x80000000u + i, 4);
+  }
+  const auto run = [&] {
+    const auto result = aurora::gx::fifo::process(bytes.data(), static_cast<u32>(bytes.size()));
+    EXPECT_EQ(result.bytesProcessed, bytes.size()); EXPECT_FALSE(result.drawDone);
+  };
+  run();
+  const unsigned last = packets - 1;
+  const auto& array = g_gxState.arrays[GX_VA_TEX0];
+  EXPECT_EQ(array.data, arrays[last % arrays.size()].data());
+  EXPECT_EQ(array.size, arrays[0].size()); EXPECT_EQ(array.le, bool(last & 1));
+  EXPECT_EQ(std::vector<u8>(static_cast<const u8*>(array.data), static_cast<const u8*>(array.data) + array.size),
+            std::vector<u8>(arrays[last % arrays.size()].begin(), arrays[last % arrays.size()].end()));
+  const auto& tex = g_gxState.loadedTextures[0];
+  EXPECT_EQ(tex.data, arrays[last % arrays.size()].data());
+  EXPECT_EQ(tex.userData, arrays[(last + 3) % arrays.size()].data());
+  EXPECT_EQ(tex.mWidth, 32 + last % 64); EXPECT_EQ(tex.mHeight, 64 + last % 128);
+  EXPECT_EQ(tex.mFormat, GX_TF_RGBA8); EXPECT_EQ(tex.tlut, GX_TLUT0);
+  EXPECT_EQ(tex.flags & 1u, last & 1u); EXPECT_EQ(tex.texObjId, 0x90000000u + last);
+  EXPECT_EQ(tex.texDataVersion, 0x80000000u + last);
+  if (std::getenv("MP_DECODER_PACKET_BENCH") != nullptr) {
+    for (unsigned i = 0; i < 8; ++i) run();
+    std::array<double, 9> timings{};
+    for (auto& ns : timings) {
+      const auto start = std::chrono::steady_clock::now();
+      for (unsigned i = 0; i < 64; ++i) run();
+      ns = std::chrono::duration<double, std::nano>(std::chrono::steady_clock::now() - start).count() /
+           (64 * packets * 2);
+    }
+    std::sort(timings.begin(), timings.end());
+    std::printf("DECODER_PACKET_BENCH packets_per_sample=%u bytes_per_sample=%zu median_ns_per_packet=%.3f min_ns=%.3f max_ns=%.3f (actual process, CPU host, no draw/GPU work)\n",
+                64 * packets * 2, 64 * bytes.size(), timings[4], timings.front(), timings.back());
+  }
+}
