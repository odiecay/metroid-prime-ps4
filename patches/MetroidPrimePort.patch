diff --git a/extern/aurora/lib/gx/uniform_reuse_key.hpp b/extern/aurora/lib/gx/uniform_reuse_key.hpp
new file mode 100644
index 00000000..a6c843fb
--- /dev/null
+++ b/extern/aurora/lib/gx/uniform_reuse_key.hpp
@@ -0,0 +1,80 @@
+#pragma once
+
+#include "gx.hpp"
+
+#include <array>
+#include <bit>
+#include <optional>
+
+namespace aurora::gx::uniform_reuse {
+
+// Every selection and emission order used by the ordinary LDR uniform packer.
+// Numeric constants remain protected by DirtyUniform. Advanced passes retain
+// the full pack path because some of their values derive from pipeline state.
+static_assert(MaxTevRegs <= 8 && MaxKColors <= 8 && MaxColorChannels / 2 <= 8 && MaxTextures <= 8);
+
+struct Layout {
+  std::array<uint64_t, 4> words{};
+  bool operator==(const Layout&) const = default;
+};
+
+inline std::optional<Layout> layout(const ShaderInfo& info, const ShaderConfig& config) noexcept {
+  if (info.usesPbr || info.usesPbrThermal || info.usesHdrTone || info.usesVolFog || info.usesShadow ||
+      info.usesShell || info.actorDecal || info.shellScene || config.pbr || config.sceneHdr ||
+      config.volFog || config.shadow || config.shell || config.actorDecal || config.depthOnly || config.drawId) {
+    return {};
+  }
+
+  Layout result;
+  result.words[0] = info.uniformSize;
+  result.words[1] = info.loadsTevReg.to_ullong() | (info.sampledKColors.to_ullong() << 8) |
+                    (info.sampledColorChannels.to_ullong() << 16) | (info.sampledTextures.to_ullong() << 24);
+  result.words[2] = uint64_t(info.lineMode) | (uint64_t(info.lightingEnabled) << 2) |
+                    (uint64_t(info.usesFog) << 3) | (uint64_t(info.usesPTTexMtx.any()) << 4) |
+                    (uint64_t(info.usedIndTexMtxs.any()) << 5) | (uint64_t(info.usesHudDyin) << 6) |
+                    (uint64_t(info.usesClipPlane) << 7) | (uint64_t(info.usesAlphaRef) << 8) |
+                    (uint64_t(info.usesColorMatrix) << 9);
+  for (size_t i = 0; i < info.sampledColorChannels.size(); ++i) {
+    if (!info.sampledColorChannels[i]) {
+      continue;
+    }
+    for (size_t alpha = 0; alpha < 2; ++alpha) {
+      const auto& channel = config.colorChannels[i + alpha * GX_ALPHA0];
+      const unsigned selected = (channel.lightingEnabled && channel.ambSrc == GX_SRC_REG ? 1u : 0u) |
+                                (channel.matSrc == GX_SRC_REG ? 2u : 0u);
+      result.words[3] |= uint64_t(selected) << (i * 4 + alpha * 2);
+    }
+  }
+  return result;
+}
+
+struct ViewportBits {
+  std::array<uint32_t, 4> words{};
+  bool operator==(const ViewportBits&) const = default;
+};
+
+inline ViewportBits viewport_bits() noexcept {
+  // The viewport setters assign even when float equality sees +0 and -0 as
+  // equal. Preserve the exact uploaded bits without changing setter behavior.
+  return {{{std::bit_cast<uint32_t>(g_gxState.renderViewport.width),
+            std::bit_cast<uint32_t>(g_gxState.renderViewport.height),
+            std::bit_cast<uint32_t>(g_gxState.logicalViewport.width),
+            std::bit_cast<uint32_t>(g_gxState.logicalViewport.height)}}};
+}
+
+struct Key {
+  Layout layout;
+  ViewportBits viewport;
