diff --git a/extern/aurora/lib/gfx/pass_lookup_memo.hpp b/extern/aurora/lib/gfx/pass_lookup_memo.hpp
new file mode 100644
index 00000000..b0597522
--- /dev/null
+++ b/extern/aurora/lib/gfx/pass_lookup_memo.hpp
@@ -0,0 +1,90 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <utility>
+
+namespace aurora::gfx::detail {
+// A render-pass lookup memo, not a resource cache. Own each resolved object until
+// the pass ends, and discard the table after custom callbacks. Producer-side
+// cache lookup/touch functions still stamp every recorded resource normally.
+// Failed resolutions are never stored, so an async pipeline can appear later
+// in the same pass. Keep the original primary replacement; a displaced entry
+// may use only its own empty secondary. Encoded commands own their references.
+template <typename Key, typename Object, size_t Capacity = 64>
+class PassLookupMemo {
+  static_assert(Capacity != 0 && (Capacity & (Capacity - 1)) == 0);
+  struct Entry {
+    Key key{};
+    Object object;
+  };
+  std::array<Entry, Capacity> m_entries{};
+  uint32_t m_hits = 0;
+  uint32_t m_misses = 0;
+  bool m_bypass = false;
+  static size_t primary(Key key) noexcept {
+    const auto bits = static_cast<uint64_t>(key);
+    return (bits ^ (bits >> 32)) & (Capacity - 1);
+  }
+  static size_t secondary(Key key) noexcept {
+    const auto bits = static_cast<uint64_t>(key);
+    return ((bits >> 6) ^ (bits >> 17)) & (Capacity - 1);
+  }
+
+public:
+  uint32_t hits() const noexcept { return m_hits; }
+  uint32_t resolved_misses() const noexcept { return m_misses; }
+  bool bypassed() const noexcept { return m_bypass; }
+  template <typename Resolve>
+  const Object* find(Key key, Object& uncached, Resolve&& resolve) {
+    // A working set that repeatedly collides should fall back to the original
+    // lookup cost for this pass. The caller owns the fallback just as before.
+    if (m_bypass) {
+      if (!resolve(uncached)) return nullptr;
+      ++m_misses;
+      return &uncached;
+    }
+    Entry& entry = m_entries[primary(key)];
+    if (entry.object && entry.key == key) {
+      ++m_hits;
+      return &entry.object;
+    }
+    // An empty primary cannot have a reachable spare for this key.
+    if (entry.object) {
+      Entry& alternate = m_entries[secondary(key)];
+      if (alternate.object && alternate.key == key) {
+        std::swap(entry, alternate);
+        const size_t at = secondary(key);
+        if (alternate.object && at != primary(alternate.key) && at != secondary(alternate.key))
+          alternate.object = nullptr;
+        ++m_hits;
+        return &entry.object;
+      }
+    }
+    if (!resolve(uncached)) {
+      return nullptr;
+    }
+    if (++m_misses >= Capacity * 2 && m_hits < m_misses / 4) {
+      m_bypass = true;
+      return &uncached;
+    }
+    if (entry.object) {
+      Entry& spare = m_entries[secondary(entry.key)];
+      if (!spare.object) spare = std::move(entry);
+    }
+    entry.object = std::move(uncached);
+    entry.key = key;
+    return &entry.object;
+  }
+
+  void clear() {
+    m_hits = m_misses = 0;
+    m_bypass = false;
+    for (auto& entry : m_entries) {
+      entry.object = nullptr;
+    }
+  }
+};
+} // namespace aurora::gfx::detail
