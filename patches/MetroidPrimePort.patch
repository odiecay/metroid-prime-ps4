+// Compose only existing glyph pixels. The cache is bounded and never moves or
+// frees borrowed texels while Aurora may still reference an old replacement.
+const IconPixels* StableChordPixels(const std::string& stem, uint32_t width, uint32_t height) {
+  constexpr size_t MaxEntries = 128, MaxBytes = 4 * 1024 * 1024;
+  static std::unordered_map<std::string, IconPixels> cache;
+  static size_t retained = 0;
+  const std::string key = stem + "@" + std::to_string(width) + "x" + std::to_string(height);
+  if (const auto it = cache.find(key); it != cache.end()) return &it->second;
+  const size_t plus = stem.find('+');
+  if (plus == std::string::npos || plus == 0 || plus + 1 == stem.size() ||
+      stem.find('+', plus + 1) != std::string::npos || width < 16 || width > 128 ||
+      height < 16 || height > 64 || cache.size() >= MaxEntries) return nullptr;
+  const uint32_t outWidth = width * 2, outHeight = height * 2;
+  const size_t bytes = size_t(outWidth) * outHeight * 4;
+  if (bytes > MaxBytes - retained) return nullptr;
+  const IconPixels* parts[2]{};
+  for (unsigned i = 0; i < 2; ++i) {
+    const std::string part = i == 0 ? stem.substr(0, plus) : stem.substr(plus + 1);
+    const std::string path = FindIconForSize(part, 32, 32);
+    if (path.empty() || !(parts[i] = StablePixels(StablePath(path)))) return nullptr;
+  }
+  IconPixels result;
+  result.width = outWidth; result.height = outHeight;
+  result.rgba.resize(bytes);
+  // Retail beam text uses a centred 0.6 x 0.85 image crop. Fit every control
+  // inside that crop rather than cutting off the modifier or direction.
+  const int left = int(outWidth) / 5 + 1, right = int(outWidth) - left;
+  const int top = int(outHeight) / 12 + 1, bottom = int(outHeight) - top;
+  const int plusSize = std::max(4, int(outHeight) / 8);
+  const int gap = std::max(1, int(outHeight) / 32);
+  const int tileWidth = (right - left - plusSize - gap * 2) / 2;
+  if (tileWidth <= 0 || bottom <= top) return nullptr;
+  for (unsigned i = 0; i < 2; ++i) {
+    const IconPixels& src = *parts[i];
+    uint32_t minX = src.width, minY = src.height, maxX = 0, maxY = 0;
+    bool visible = false;
+    for (uint32_t y = 0; y < src.height; ++y) for (uint32_t x = 0; x < src.width; ++x) {
+      if (!src.rgba[(size_t(y) * src.width + x) * 4 + 3]) continue;
+      minX = std::min(minX, x); minY = std::min(minY, y);
+      maxX = std::max(maxX, x); maxY = std::max(maxY, y); visible = true;
+    }
+    if (!visible) return nullptr;
+    const uint32_t cropWidth = maxX - minX + 1, cropHeight = maxY - minY + 1;
+    const float scale = std::min(float(tileWidth) / cropWidth, float(bottom - top) / cropHeight);
+    const int drawWidth = std::max(1, int(cropWidth * scale));
+    const int drawHeight = std::max(1, int(cropHeight * scale));
+    const int tileLeft = i == 0 ? left : right - tileWidth;
+    const int startX = tileLeft + (tileWidth - drawWidth) / 2;
+    const int startY = top + (bottom - top - drawHeight) / 2;
+    for (int y = 0; y < drawHeight; ++y) for (int x = 0; x < drawWidth; ++x) {
+      const uint32_t sourceX = minX + uint32_t(x) * cropWidth / drawWidth;
+      const uint32_t sourceY = minY + uint32_t(y) * cropHeight / drawHeight;
+      const size_t srcOffset = (size_t(sourceY) * src.width + sourceX) * 4;
+      const size_t dstOffset = (size_t(startY + y) * outWidth + startX + x) * 4;
+      std::memcpy(result.rgba.data() + dstOffset, src.rgba.data() + srcOffset, 4);
+    }
+  }
+  const int cx = int(outWidth) / 2, cy = int(outHeight) / 2;
+  const int stroke = std::max(1, int(outHeight) / 32);
+  for (int y = cy - plusSize / 2; y <= cy + plusSize / 2; ++y)
+    for (int x = cx - plusSize / 2; x <= cx + plusSize / 2; ++x)
+      if (std::abs(x - cx) < stroke || std::abs(y - cy) < stroke) {
+        const size_t at = (size_t(y) * outWidth + x) * 4;
+        result.rgba[at] = result.rgba[at + 1] = result.rgba[at + 2] = 235;
+        result.rgba[at + 3] = 255;
+      }
+  retained += bytes;
+  return &cache.emplace(key, std::move(result)).first->second;
+}
