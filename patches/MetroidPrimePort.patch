new file mode 100644
index 00000000..6c01b213
--- /dev/null
+++ b/extern/aurora/lib/gx/fifo_metrics.hpp
@@ -0,0 +1,30 @@
+#pragma once
+#include <cstdint>
+#include <limits>
+
+namespace aurora::gx::fifo {
+// Decoder-owned totals; the producer consumes/resets only after drain's acquire
+// observes the decoder's completion release. No per-command clocks or events.
+struct BatchSample {
+  uint64_t wall = 0;
+  uint64_t cpu = std::numeric_limits<uint64_t>::max();
+};
+struct BatchMetrics {
+  uint64_t batches = 0, bytes = 0, wallNs = 0, cpuNs = 0;
+  uint64_t cpuSamples = 0, unavailableCpu = 0, invalidWall = 0;
+
+  void Record(BatchSample begin, BatchSample end, uint64_t consumedBytes) noexcept {
+    ++batches;
+    bytes += consumedBytes;
+    if (end.wall >= begin.wall) wallNs += end.wall - begin.wall;
+    else ++invalidWall;
+    constexpr uint64_t unavailable = std::numeric_limits<uint64_t>::max();
+    if (begin.cpu == unavailable || end.cpu == unavailable || end.cpu < begin.cpu) {
+      ++unavailableCpu;
+    } else {
+      ++cpuSamples;
+      cpuNs += end.cpu - begin.cpu;
+    }
+  }
+};
+}
