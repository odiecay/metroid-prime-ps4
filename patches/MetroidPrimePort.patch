+
+void PutLE(std::vector<uint8_t>& out, uint64_t value, unsigned bytes) {
+  for (unsigned i=0;i<bytes;++i) out.push_back(uint8_t(value >> (i*8)));
+}
+
+std::vector<uint8_t> MakeReadCache(const std::vector<std::pair<std::string,std::vector<uint8_t>>>& entries) {
+  size_t tableEnd = 24;
+  for (const auto& entry : entries) tableEnd += 32 + entry.first.size();
+  size_t end = (tableEnd+31)&~size_t(31);
+  for (const auto& entry : entries) end += (entry.second.size()+31)&~size_t(31);
+  std::vector<uint8_t> bytes;
+  for (char c : std::string("MPRC0001")) bytes.push_back(uint8_t(c));
+  PutLE(bytes,entries.size(),4);PutLE(bytes,tableEnd,4);PutLE(bytes,end,8);
+  size_t offset = (tableEnd+31)&~size_t(31);
+  for (const auto& entry : entries) {
+    uint64_t hash=14695981039346656037ull;
+    for (uint8_t c : entry.second) hash=(hash^c)*1099511628211ull;
+    PutLE(bytes,entry.first.size(),4);PutLE(bytes,0,4);PutLE(bytes,entry.second.size(),8);
+    PutLE(bytes,offset,8);PutLE(bytes,hash,8);
+    bytes.insert(bytes.end(),entry.first.begin(),entry.first.end());
+    offset+=(entry.second.size()+31)&~size_t(31);
+  }
+  bytes.resize(end,0);
+  offset=(tableEnd+31)&~size_t(31);
+  for (const auto& entry : entries) {
+    std::copy(entry.second.begin(),entry.second.end(),bytes.begin()+offset);
+    offset+=(entry.second.size()+31)&~size_t(31);
+  }
+  return bytes;
+}
+
+void TestReadCache(const fs::path& dir) {
+  const auto packPath=dir/PortMods::kResourceReadCacheName;
+  const std::vector<std::pair<std::string,std::vector<uint8_t>>> entries{
+    {"00000011.PART",std::vector<uint8_t>(41,'p')},
+    {"nested/00000022.TXTR",std::vector<uint8_t>(17,'t')}};
+  const auto good=MakeReadCache(entries);
+  auto write=[&](const std::vector<uint8_t>& bytes) {
+    std::ofstream out(packPath,std::ios::binary);
+    out.write(reinterpret_cast<const char*>(bytes.data()),std::streamsize(bytes.size()));
+  };
+  write(good);
+  PortMods::ResourceReadCache cache;std::string error;
+  CHECK_MSG(PortMods::LoadResourceReadCache(packPath.string(),cache,error),"read cache valid");
+  CHECK_MSG(cache.entries.size()==2 && cache.payloadBytes==58,"cache counts");
+  PortMods::LooseResource part{0x50415254,0x11,(dir/"absent.PART").string(),41,"test"};
+  PortMods::LooseResource texture{kTXTR,0x22,(dir/"absent.TXTR").string(),17,"test"};
+  CHECK_MSG(cache.Bind(entries[0].first,part) && cache.Bind(entries[1].first,texture),"cache binds known paths");
+  auto wrong=part;wrong.hostSize=40;
+  CHECK_MSG(!cache.Bind(entries[0].first,wrong),"changed size falls back");
+  CHECK_MSG(!cache.Bind("another/00000011.PART",wrong),"path identity preserved");
+  const auto pak=PortMods::NewPak({&part,&texture});
+  const auto golden=ReadAll(pak,4096);
+  // The scan and its dictionary may disappear; virtual PAKs own the backing.
+  cache={};part.cached.reset();texture.cached.reset();
+  for(size_t chunk:{size_t(1),size_t(17),size_t(71),size_t(4096)}) {
+    CHECK_MSG(ReadAll(pak,chunk)==golden,"cached read ownership and arbitrary ranges");
+  }
+  const size_t partAt=Get32(golden,16+16), texAt=Get32(golden,36+16);
+  CHECK_MSG(std::equal(entries[0].second.begin(),entries[0].second.end(),golden.begin()+partAt),"cached PART exact");
+  CHECK_MSG(std::equal(entries[1].second.begin(),entries[1].second.end(),golden.begin()+texAt),"cached TXTR exact");
+  CHECK_MSG(std::all_of(golden.begin()+partAt+41,golden.begin()+texAt,[](uint8_t c){return c==0;}),"cache PAK padding isolated");
+  CHECK_MSG(!PortMods::LoadResourceReadCache(packPath.string(),cache,error,good.size()-1),"cache budget enforced");
+  auto reject=[&](std::vector<uint8_t> bad,const char* what) {
+    write(bad);CHECK_MSG(!PortMods::LoadResourceReadCache(packPath.string(),cache,error),what);
+    CHECK_MSG(!cache.bytes && cache.entries.empty(),"failed cache publishes nothing");
+  };
+  auto bad=good;bad.back()='!'; // padding is not semantic payload
+  write(bad);CHECK_MSG(PortMods::LoadResourceReadCache(packPath.string(),cache,error),"padding does not affect payload checksum");
+  bad=good;bad[128]^=1;reject(bad,"corrupt payload rejected");
+  bad=good;bad[0]='X';reject(bad,"cache format rejected");
+  bad=good;bad[24+4]=1;reject(bad,"future entry flags rejected");
+  bad=good;bad[24+16]=1;reject(bad,"overlapping payload rejected");
+  bad=good;bad[24+8]=255;reject(bad,"payload bounds rejected");
+  bad=good;bad.resize(25);reject(bad,"truncated cache rejected");
+  reject(MakeReadCache({{"../00000011.PART",{1}}}),"cache traversal rejected");
+  reject(MakeReadCache({{"00000011.PART",{1}},{"00000011.PART",{2}}}),"duplicate cache entry rejected");
+  reject(MakeReadCache({{"b/00000011.PART",{1}},{"a/00000011.PART",{2}}}),"unsorted cache rejected");
+  fs::remove(packPath);
+  CHECK_MSG(!PortMods::LoadResourceReadCache(packPath.string(),cache,error),"absent optional cache falls back");
+}
