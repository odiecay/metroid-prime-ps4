new file mode 100644
index 00000000..32bde032
--- /dev/null
+++ b/platform/include/port_frontend_layout.h
@@ -0,0 +1,74 @@
+#ifndef PORT_FRONTEND_LAYOUT_H
+#define PORT_FRONTEND_LAYOUT_H
+
+#include "port_env.h"
+
+// The GameCube front-end movies contain a 16:9 picture inside a 640x480
+// raster. Match the native menu camera to that picture, rather than stretching
+// either the movie or its independently drawn text and button prompts.
+namespace PortFrontEndLayout {
+inline bool Fullscreen() {
+#ifdef __ORBIS__
+  constexpr bool fallback = true;
+#else
+  constexpr bool fallback = false;
+#endif
+  static const bool enabled = port::EnvFlag("MP_FRONTEND_FULLSCREEN", fallback);
+  return enabled;
+}
+
+inline float Zoom(float aspect) {
+  constexpr float original = 4.f / 3.f;
+  constexpr float picture = 16.f / 9.f;
+  if (!(aspect > original)) {
+    return 1.f;
+  }
+  return (aspect < picture ? aspect : picture) / original;
+}
+
+inline bool EmbeddedPicture(unsigned width, unsigned height) {
+  if (width == 640 && height == 480) {
+    return true;
+  }
+#ifdef __ORBIS__
+  // PC-prepared 1.5x/2x/3x/4x copies retain the authored 4:3 raster and its cinema
+  // bars. Use the same picture crop and GUI camera as the original movie.
+  // Genuine widescreen replacements keep their independent framing.
+  return (width == 960 && height == 720) || (width == 1280 && height == 960) ||
+         (width == 1920 && height == 1440) || (width == 2560 && height == 1920);
+#else
+  return false;
+#endif
+}
+
+inline bool FillPicture(bool enabled, bool widescreen, bool menuMovie,
+                        unsigned width, unsigned height) {
+  return enabled && widescreen && menuMovie && EmbeddedPicture(width, height);
+}
+
+struct MovieRect {
+  float left, top, right, bottom;
+};
+
+inline MovieRect PictureRect(float left, float top, float width, float height) {
+  const float zoom = width > 0.f && height > 0.f ? Zoom(width / height) : 1.f;
+  const float halfWidth = height * (4.f / 3.f) * zoom * 0.5f;
+  const float halfHeight = height * zoom * 0.5f;
+  const float x = left + width * 0.5f;
+  const float y = top + height * 0.5f;
+  return {x - halfWidth, y - halfHeight, x + halfWidth, y + halfHeight};
+}
+
+// A point measured from either edge in the authored 480-line raster. Texture
+// prompts follow the movie's centre zoom, including their dimensions.
+inline float PromptPosition(float position, float viewportHeight, float zoom,
+                            float promptHeight = 0.f) {
+  const float mapped = viewportHeight * (0.5f + (position / 480.f - 0.5f) * zoom);
+  // The original title prompt touches the edge of the picture band. Leave a
+  // small safe inset when that band becomes the whole TV picture.
+  const float inset = viewportHeight / 24.f + promptHeight * 0.5f;
+  return mapped > inset ? mapped : inset;
+}
+} // namespace PortFrontEndLayout
+
+#endif
