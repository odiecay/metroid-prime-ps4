diff --git a/extern/aurora/lib/gfx/command_pool.hpp b/extern/aurora/lib/gfx/command_pool.hpp
new file mode 100644
index 00000000..03871f26
--- /dev/null
+++ b/extern/aurora/lib/gfx/command_pool.hpp
@@ -0,0 +1,53 @@
+#pragma once
+#include <array>
+#include <cstddef>
+#include <memory>
+#include <utility>
+#include <vector>
+
+namespace aurora::gfx::detail {
+// Empty CPU vectors only: put() destroys every element before retaining its
+// allocation. The frame-slot owner provides synchronization. FIFO reuse keeps
+// stable pass sequences paired with the capacities they needed last frame.
+template<class T, size_t Slots = 128, class Allocator = std::allocator<T>>
+class CommandStoragePool {
+public:
+  using Vector = std::vector<T, Allocator>;
+  explicit CommandStoragePool(size_t byteLimit = 8u << 20) noexcept : m_limit(byteLimit) {}
+  CommandStoragePool(const CommandStoragePool&) = delete;
+  CommandStoragePool& operator=(const CommandStoragePool&) = delete;
+
+  Vector take() noexcept {
+    if (m_count == 0) return {};
+    auto value = std::move(m_buffers[m_first]);
+    m_bytes -= value.capacity() * sizeof(T);
+    m_first = (m_first + 1) % Slots;
+    --m_count;
+    return value;
+  }
+
+  void put(Vector value) noexcept {
+    value.clear();
+    const auto capacity = value.capacity();
+    if (capacity == 0 || capacity > m_limit / sizeof(T) || m_count == Slots) return;
+    const auto bytes = capacity * sizeof(T);
+    if (bytes > m_limit - m_bytes) return;
+    m_buffers[(m_first + m_count) % Slots] = std::move(value);
+    ++m_count;
+    m_bytes += bytes;
+  }
+
+  void clear() noexcept {
+    for (auto& buffer : m_buffers) Vector{}.swap(buffer);
+    m_first = m_count = m_bytes = 0;
+  }
+  size_t retained_bytes() const noexcept { return m_bytes; }
+  size_t size() const noexcept { return m_count; }
+  size_t byte_limit() const noexcept { return m_limit; }
+
+private:
+  static_assert(Slots > 0);
+  std::array<Vector, Slots> m_buffers;
+  size_t m_first = 0, m_count = 0, m_bytes = 0, m_limit;
+};
+} // namespace aurora::gfx::detail
