diff --git a/extern/aurora/include/aurora/frame_trace.hpp b/extern/aurora/include/aurora/frame_trace.hpp
new file mode 100644
index 00000000..950ffd1c
--- /dev/null
+++ b/extern/aurora/include/aurora/frame_trace.hpp
@@ -0,0 +1,154 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+
+// Bounded single-producer rings: the owner thread alone writes its ring, the
+// diagnostics thread alone drains. No heap allocation, locks, or I/O on emit.
+namespace aurora::trace {
+enum Lane : uint8_t { Main, Render };
+enum Kind : uint8_t { Phase, Inclusive, Counter, Complete, Gpu, CpuTime };
+struct Event {
+  uint64_t frame{}, startNs{}, value{};
+  const char* name{}; // string literal, process lifetime
+  Lane lane{};
+  Kind kind{};
+};
+constexpr unsigned MaxThreads = 8, Capacity = 4096;
+#if defined(__ORBIS__) || defined(PRIME_TRACE_TEST)
+struct alignas(64) Ring {
+  std::array<Event, Capacity> events{};
+  alignas(64) std::atomic<uint64_t> written{0};
+  alignas(64) std::atomic<uint64_t> read{0};
+  std::atomic<uint64_t> dropped{0};
+  std::atomic<unsigned> owner{0}; // free / active / retired awaiting final drain
+};
+inline std::array<Ring, MaxThreads> rings;
+inline std::atomic<uint64_t> unregisteredDrops{0};
+// Optional native diagnostic, installed before worker startup. Called once
+// after ownership is claimed, never for individual trace events.
+inline void (*registration_observer)(const void* registrationTlsAddress, unsigned claimedSlot) noexcept = nullptr;
+// Native observer reads this once per claim to distinguish a copied TLS
+// template from zero-only initialization. It never controls ring ownership.
+inline thread_local volatile uint32_t tls_template_canary=0x5052544c;
+struct Registration {
+  // Zero must mean unregistered, including when native TLS bootstrap supplies
+  // only zero-filled storage instead of the nonzero template initializer.
+  // An index initialized to MaxThreads would then silently become slot zero,
+  // allowing unrelated threads to publish into the same SPSC ring.
+  unsigned indexPlusOne=0;
+  unsigned acquire() noexcept {
+    if(indexPlusOne) return indexPlusOne-1;
+    for(unsigned i=0;i<MaxThreads;++i) {
+      unsigned free=0;
+      if(rings[i].owner.compare_exchange_strong(free,1,std::memory_order_acq_rel)) {
+        indexPlusOne=i+1;
+        if(registration_observer) registration_observer(this,i);
+        return i;
+      }
+    }
+    return MaxThreads;
+  }
+  ~Registration() {
+    if(indexPlusOne) rings[indexPlusOne-1].owner.store(2,std::memory_order_release);
+  }
+};
+inline std::atomic<uint64_t> nextFrame{1};
+inline uint64_t next_frame() noexcept { return nextFrame.fetch_add(1, std::memory_order_relaxed); }
+inline uint64_t (*cpu_clock)() noexcept = nullptr;
+struct Context { uint64_t frame{}, start{}, since{}, cpuStart=UINT64_MAX; const char* phase{}; };
+inline thread_local std::array<Context, 2> contexts;
+inline uint64_t now_ns() noexcept {
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+inline void emit(const Event& event) noexcept {
+  static thread_local Registration registration;
+  const auto thread=registration.acquire();
+  if (thread >= MaxThreads) { unregisteredDrops.fetch_add(1,std::memory_order_relaxed);return; }
+  auto& ring = rings[thread];
+  const auto w = ring.written.load(std::memory_order_relaxed);
+  if (w - ring.read.load(std::memory_order_acquire) >= Capacity) {
+    ring.dropped.fetch_add(1, std::memory_order_relaxed);
+    return;
+  }
+  ring.events[w % Capacity] = event;
+  ring.written.store(w + 1, std::memory_order_release);
+}
+template<class F> inline void drain(unsigned thread, F&& consume) {
+  auto& ring = rings[thread];
+  auto r = ring.read.load(std::memory_order_relaxed);
+  const auto w = ring.written.load(std::memory_order_acquire);
+  while (r != w) consume(ring.events[r++ % Capacity]);
+  ring.read.store(r, std::memory_order_release);
+  if(ring.owner.load(std::memory_order_acquire)==2 && r==ring.written.load(std::memory_order_acquire))
+    ring.owner.store(0,std::memory_order_release);
+}
+inline void transition(Lane lane, const char* name, uint64_t now) noexcept {
+  auto& c = contexts[lane];
+  if (c.frame && c.phase && now >= c.since) emit({c.frame, c.since, now-c.since, c.phase, lane, Phase});
+  c.phase = name; c.since = now;
+}
+inline void begin(Lane lane, uint64_t id) noexcept {
+  const auto now = now_ns();
+  contexts[lane] = {id, now, now, cpu_clock?cpu_clock():UINT64_MAX, lane == Main ? "frame setup" : "render worker lifetime (includes producer waits)"};
+}
+inline void end(Lane lane) noexcept {
+  const auto now = now_ns();
+  auto& c = contexts[lane];
+  transition(lane, nullptr, now);
+  if(c.frame && cpu_clock) {
+    const auto cpu=cpu_clock();
+    if(c.cpuStart!=UINT64_MAX && cpu!=UINT64_MAX && cpu>=c.cpuStart) {
+      emit({c.frame,now,1,"thread CPU clock samples",lane,Counter});
+      const auto busy=cpu-c.cpuStart;
+      emit({c.frame,c.start,busy,"thread CPU execution",lane,CpuTime});
+      if(now>=c.start && now-c.start>=busy)
+        emit({c.frame,c.start,now-c.start-busy,"non-running wall (sleep/wait/descheduled)",lane,Inclusive});
+    } else emit({c.frame,now,1,"thread CPU clock unavailable",lane,Counter});
+  }
+  if (c.frame) emit({c.frame, c.start, now-c.start, "complete frame wall", lane, Complete});
+  c = {};
+}
+inline uint64_t frame_id(Lane lane = Main) noexcept { return contexts[lane].frame; }
+inline void gpu_sample(const char* name,uint64_t ns) noexcept {
+  emit({0,now_ns(),ns,name,Render,Gpu});
+}
+// Explicit IDs let an arriving queue item report its canonical game-frame
+// trace before begin(Render), without mistaking the internal packet serial for it.
+inline void count(const char* name, uint64_t value, Lane lane = Render, uint64_t frame = UINT64_MAX) noexcept {
+  emit({frame == UINT64_MAX ? contexts[lane].frame : frame, now_ns(), value, name, lane, Counter});
+}
+inline void interval(const char* name, uint64_t frame, uint64_t start, uint64_t elapsed, Lane lane) noexcept {
+  if (elapsed) emit({frame, start, elapsed, name, lane, Inclusive});
+}
+class Scope {
+  Lane lane_; const char* name_; uint64_t frame_, start_;
+public:
+  explicit Scope(const char* name, Lane lane = Main) noexcept
+  : lane_(lane), name_(name), frame_(contexts[lane].frame), start_(now_ns()) {}
+  ~Scope() { emit({frame_, start_, now_ns()-start_, name_, lane_, Inclusive}); }
+  Scope(const Scope&) = delete;
+};
+class Frame {
+  Lane lane_;
+public:
+  Frame(Lane lane, uint64_t id) : lane_(lane) { begin(lane, id); }
+  ~Frame() { end(lane_); }
+  Frame(const Frame&) = delete;
+};
+#else
+inline uint64_t now_ns() noexcept { return 0; }
+inline uint64_t next_frame() noexcept { return 0; }
+inline uint64_t frame_id(Lane = Main) noexcept { return 0; }
+inline void transition(Lane, const char*, uint64_t) noexcept {}
+inline void begin(Lane, uint64_t) noexcept {}
+inline void end(Lane) noexcept {}
+inline void gpu_sample(const char*,uint64_t) noexcept {}
+inline void count(const char*, uint64_t, Lane = Render, uint64_t = UINT64_MAX) noexcept {}
+inline void interval(const char*, uint64_t, uint64_t, uint64_t, Lane) noexcept {}
+struct Scope { explicit Scope(const char*, Lane = Main) noexcept {} };
+struct Frame { Frame(Lane, uint64_t) noexcept {} };
+#endif
+}
