+std::string BeamHelpStem(uint32_t prompt, const char* device) {
+  const int help = sBeamHelp.load(std::memory_order_relaxed);
+  if (help < 0 || std::strcmp(device, "playstation") != 0) return {};
+  int direction = help;
+  bool whole = false;
+  switch (prompt) {
+  case PROMPT_CSTICK: case PROMPT_DPAD: whole = true; break;
+  case PROMPT_CSTICK_UP: case PAD_BUTTON_UP: direction = 0; break;
+  case PROMPT_CSTICK_DOWN: case PAD_BUTTON_DOWN: direction = 1; break;
+  case PROMPT_CSTICK_LEFT: case PAD_BUTTON_LEFT: direction = 2; break;
+  case PROMPT_CSTICK_RIGHT: case PAD_BUTTON_RIGHT: direction = 3; break;
+  default: return {};
+  }
+  PortInput::Binding binding;
+  if (!PortInputDevices::PromptBeamBinding(direction, binding) || binding.count > 2) return {};
+  std::string stem;
+  for (unsigned i = 0; i < binding.count; ++i) {
+    const std::string part = BeamInputStem(binding.inputs[i], device, whole && i + 1 == binding.count);
+    if (part.empty()) return {};
+    if (!stem.empty()) stem += '+';
+    stem += part;
+  }
+  return stem;
+}
