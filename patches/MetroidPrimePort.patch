new file mode 100644
index 00000000..b01290a6
--- /dev/null
+++ b/extern/aurora/lib/gfx/encoding_state.hpp
@@ -0,0 +1,40 @@
+#pragma once
+#include <cstdint>
+#include <optional>
+
+namespace aurora::gfx {
+// Encoder-local state only. Reset at pass boundaries and after code which
+// binds resources directly; no cache entry extends a resource's lifetime.
+struct GXEncodingState {
+  uintptr_t uniformGroup = 0;
+  uint32_t uniformOffset = 0;
+  uintptr_t indexBuffer = 0;
+  uint64_t indexBytes = 0;
+  bool uniformValid = false;
+  bool indexValid = false;
+
+  void reset() noexcept { *this = {}; }
+  bool bind_uniform(uintptr_t group, uint32_t offset) noexcept {
+    if (uniformValid && uniformGroup == group && uniformOffset == offset) return false;
+    uniformGroup = group;
+    uniformOffset = offset;
+    uniformValid = true;
+    return true;
+  }
+  bool has_index(uintptr_t buffer) const noexcept {
+    return indexValid && indexBuffer == buffer;
+  }
+  void bind_index(uintptr_t buffer, uint64_t bytes) noexcept {
+    indexBuffer = buffer;
+    indexBytes = bytes;
+    indexValid = true;
+  }
+  std::optional<uint32_t> first_index(uint32_t offset, uint32_t bytes, uint32_t count) const noexcept {
+    if (!indexValid || (offset & 1) || offset > indexBytes || bytes > indexBytes - offset ||
+        uint64_t(count) * sizeof(uint16_t) > bytes) return std::nullopt;
+    // Binding the whole buffer and shifting firstIndex fetches exactly the
+    // same uint16 elements as binding this byte range at firstIndex zero.
+    return offset / sizeof(uint16_t);
+  }
+};
+} // namespace aurora::gfx
