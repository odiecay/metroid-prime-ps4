@@ -0,0 +1,69 @@
+#pragma once
+#include <array>
+#include <cassert>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace aurora::gx::fifo::detail {
+inline constexpr std::size_t SmallCopyLimit = 256;
+inline constexpr std::size_t SmallCopyBins = 8;
+// The exact48-byte bucket separates a common FIFO payload from nearby sizes.
+constexpr std::size_t small_copy_bin(std::uint32_t bytes) noexcept {
+  if (bytes <= 16) return 0;
+  if (bytes <= 32) return 1;
+  if (bytes < 48) return 2;
+  if (bytes == 48) return 3;
+  if (bytes <= 64) return 4;
+  if (bytes <= 128) return 5;
+  return bytes <= SmallCopyLimit ? 6 : 7;
+}
+struct FifoSmallCopyPreflight {
+  std::array<std::uint32_t, SmallCopyBins> lengths{};
+  bool allSmall = true;
+  bool collect = false;
+  explicit FifoSmallCopyPreflight(bool profile = false) noexcept : collect(profile) {}
+  void add(std::uint32_t bytes) noexcept {
+    allSmall &= bytes <= SmallCopyLimit;
+    if (collect) ++lengths[small_copy_bin(bytes)];
+  }
+  static FifoSmallCopyPreflight one(std::uint32_t bytes, bool profile) noexcept {
+    FifoSmallCopyPreflight result{profile}; result.add(bytes); return result;
+  }
+};
+struct FifoSmallCopyCounters {
+  std::uint64_t eligibleBatches = 0, eligibleBytes = 0;
+  std::uint64_t smallBatches = 0, smallBytes = 0;
+  std::uint64_t fallbackBatches = 0, fallbackBytes = 0;
+  std::array<std::uint64_t, SmallCopyBins> lengths{};
+  void record(const FifoSmallCopyPreflight& preflight, std::uint64_t bytes, bool requested) noexcept {
+    if (!preflight.collect) return;
+    if (preflight.allSmall) { ++eligibleBatches; eligibleBytes += bytes; }
+    if (requested && preflight.allSmall) { ++smallBatches; smallBytes += bytes; }
+    else { ++fallbackBatches; fallbackBytes += bytes; }
+    for (std::size_t i = 0; i < SmallCopyBins; ++i) lengths[i] += preflight.lengths[i];
+  }
+  FifoSmallCopyCounters take() noexcept { auto result = *this; *this = {}; return result; }
+};
+
+template <std::size_t Bytes>
+inline void copy_fifo_constant(std::uint8_t* dst, const std::uint8_t* src) noexcept {
+#if defined(__clang__) && __has_builtin(__builtin_memcpy_inline)
+  __builtin_memcpy_inline(dst, src, Bytes);
+#else
+  std::memcpy(dst, src, Bytes);
+#endif
+}
+// Preconditions: disjoint FIFO/staging allocations, and the COMPLETE accepted
+// batch preflight proves every payload<=256. Exact-sized operations touch no
+// byte outside either range. Larger batches use the original libc write loop.
+inline void copy_small_fifo_payload(std::uint8_t* dst, const std::uint8_t* src,
+                                    std::size_t length) noexcept {
+  assert(length <= SmallCopyLimit);
+  while (length >= 16) { copy_fifo_constant<16>(dst, src); dst += 16; src += 16; length -= 16; }
+  if (length & 8) { copy_fifo_constant<8>(dst, src); dst += 8; src += 8; }
+  if (length & 4) { copy_fifo_constant<4>(dst, src); dst += 4; src += 4; }
+  if (length & 2) { copy_fifo_constant<2>(dst, src); dst += 2; src += 2; }
+  if (length & 1) { copy_fifo_constant<1>(dst, src); }
+}
+} // namespace aurora::gx::fifo::detail
