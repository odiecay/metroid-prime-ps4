+// Exact floor/partial-primitive semantics of prepare_idx_buffer. Only callers
+// that have checked the destination and per-record index count use this writer.
+static u16* write_prepared_indexed(u16* out, GXPrimitive prim, u16 base, u16 count) noexcept {
+  if (prim == GX_QUADS) {
+    for (u32 v = 0; v + 4 <= count; v += 4) {
+      const u16 idx = u16(base + v);
+      *out++ = idx; *out++ = u16(idx + 1); *out++ = u16(idx + 2);
+      *out++ = u16(idx + 2); *out++ = u16(idx + 3); *out++ = idx;
+    }
+  } else if (prim == GX_TRIANGLES) {
+    for (u32 v = 0; v < u32(count) / 3 * 3; ++v) *out++ = u16(base + v);
+  } else if (count >= 3) {
+    *out++ = base; *out++ = u16(base + 1); *out++ = u16(base + 2);
+    for (u32 v = 3; v < count; ++v) {
+      *out++ = base; *out++ = u16(base + v - 1); *out++ = u16(base + v);
+    }
+  }
+  return out;
+}
