diff --git a/platform/include/port_mod_inventory.h b/platform/include/port_mod_inventory.h
new file mode 100644
index 00000000..a171793c
--- /dev/null
+++ b/platform/include/port_mod_inventory.h
@@ -0,0 +1,60 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <cstdint>
+#include <filesystem>
+#include <fstream>
+#include <optional>
+#include <sstream>
+#include <unordered_map>
+#include <vector>
+
+// An installed package is immutable for the life of the process. Reuse its
+// verified file index when graphics settings cause a mod reload, rather than
+// walking and stat'ing thousands of unchanged files again. Writable mods keep
+// the existing filesystem scan. This is only used after the platform validates
+// the installed asset set; absence or malformed input falls back to scanning.
+class PortModInventory {
+  using Path = std::filesystem::path;
+  Path index_, mod_;
+  bool ready_ = false;
+  std::vector<Path> files_;
+  std::unordered_map<std::string, uint64_t> sizes_;
+public:
+  bool Load(const Path& index, const Path& mod) {
+    if (index == index_ && mod == mod_) return ready_;
+    index_ = index; mod_ = mod; ready_ = false; files_.clear(); sizes_.clear();
+    if (index.empty() || mod.lexically_normal() != (index.parent_path()/"mods/remastered-models").lexically_normal()) return false;
+    std::error_code error;
+    const auto indexBytes=std::filesystem::file_size(index,error);
+    if(error || indexBytes>2*1024*1024) return false;
+    std::ifstream input(index);
+    if (!input) return false;
+    std::string line;
+    uint64_t total = 0;
+    bool stamp = false;
+    while (std::getline(input, line)) {
+      if (line.size()>512 || files_.size()>=16384) return false;
+      std::istringstream row(line);
+      uint64_t bytes; std::string name, extra;
+      if (!(row>>bytes>>name) || (row>>extra) || bytes>64ull*1024*1024 ||
+          !name.starts_with("mods/remastered-models/")) return false;
+      const Path rel(name);
+      if (rel.is_absolute() || rel.lexically_normal()!=rel) return false;
+      for (const auto& part:rel) if (part==".." || part==".") return false;
+      const Path path=index.parent_path()/rel;
+      if (!sizes_.emplace(path.generic_string(),bytes).second) return false;
+      files_.push_back(path);
+      total+=bytes;
+      if (total>3ull*1024*1024*1024) return false;
+      stamp |= name=="mods/remastered-models/.import-version";
+    }
+    ready_=input.eof() && stamp && files_.size()>1;
+    return ready_;
+  }
+  const std::vector<Path>& Files() const { return files_; }
+  std::optional<uint64_t> Size(const Path& path) const {
+    if (!ready_) return std::nullopt;
+    const auto it=sizes_.find(path.generic_string());
+    return it==sizes_.end()?std::nullopt:std::optional<uint64_t>(it->second);
+  }
+};
