+TEST(RenderWorkerFrameSlots, TimedWaitMaintainsExclusiveOwnershipAcrossThreads) {
+  FrameSlotPool slots{1};
+  std::atomic_int active = 0;
+  std::atomic_int violations = 0;
+  std::vector<std::thread> workers;
+  for (unsigned thread = 0; thread < 4; ++thread) {
+    workers.emplace_back([&] {
+      for (unsigned iteration = 0; iteration < 1000; ++iteration) {
+        const auto slot = slots.acquire_for(2s);
+        if (!slot) {
+          ++violations;
+          continue;
+        }
+        if (active.fetch_add(1) != 0) ++violations;
+        std::this_thread::yield();
+        if (active.fetch_sub(1) != 1) ++violations;
+        slots.release(*slot);
+      }
+    });
+  }
+  for (auto& worker : workers) worker.join();
+  EXPECT_EQ(violations.load(), 0);
+  EXPECT_EQ(slots.free_count(), 1u);
+}
