+static bool native_auto_quantization_fit(int nativeWidth, int nativeHeight, uint32_t logicalWidth,
+                                         uint32_t logicalHeight, int fittedWidth, int fittedHeight) noexcept {
+  if (nativeWidth <= 0 || nativeHeight <= 0 || logicalWidth == 0 || logicalHeight == 0 ||
