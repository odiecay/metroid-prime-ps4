new file mode 100644
index 00000000..3a825859
--- /dev/null
+++ b/platform/include/port_shadow_demand.h
@@ -0,0 +1,73 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+
+namespace PortShadowDemand {
+// A loaded model can become visible, or change material sets, on the next draw.
+// Track availability rather than the previous frame's visibility: first-time
+// receivers keep the existing shadow-map warm-up behavior.
+class PbrModelLease {
+  inline static std::atomic<unsigned> sCount{0};
+  bool active = false;
+public:
+  PbrModelLease() = default;
+  PbrModelLease(const PbrModelLease& other) { Set(other.active); }
+  PbrModelLease& operator=(const PbrModelLease& other) { Set(other.active);return *this; }
+  PbrModelLease(PbrModelLease&& other) noexcept : active(other.active) { other.active=false; }
+  PbrModelLease& operator=(PbrModelLease&& other) noexcept {
+    if(this!=&other) { Set(false);active=other.active;other.active=false; }
+    return *this;
+  }
+  ~PbrModelLease() { Set(false); }
+  bool Active() const { return active; }
+  void Set(bool value) {
+    if(value==active) return;
+    active=value;
+    if(value) sCount.fetch_add(1,std::memory_order_relaxed);
+    else sCount.fetch_sub(1,std::memory_order_relaxed);
+  }
+  static unsigned Count() { return sCount.load(std::memory_order_relaxed); }
+};
+
+inline bool SunMapsNeeded(bool registeredModSources, bool loadedPbrModels, bool icySource) {
+  return registeredModSources || loadedPbrModels || icySource;
+}
+inline bool ProjectedActorsNeeded(bool setting, bool geometryMode, bool registeredGeometry) {
+  return setting && geometryMode && registeredGeometry;
+}
+inline bool RoomReceiversReady(bool hasFile, bool skyOnly, size_t models, size_t loaded) {
+  return hasFile && !skyOnly && models!=0 && loaded==models;
+}
+inline bool SelectProjectedMode(bool& saved, bool selected) {
+  if(saved==selected) return false;
+  saved=selected;
+  return true;
+}
+
+// A CMDL material set: texture IDs, material count/end offsets, then material
+// records. Retail and generated retail ball looks have no PortPBR flag (bit14).
+// Invalid bounds conservatively retain maps; the regular model parser reports
+// the bad asset. Never decide to skip from a malformed material set.
+inline bool MaterialSetMayHavePbr(const uint8_t* data, size_t size) {
+  auto be32=[](const uint8_t* p) {
+    return uint32_t(p[0])<<24 | uint32_t(p[1])<<16 | uint32_t(p[2])<<8 | uint32_t(p[3]);
+  };
+  if(!data || size<8) return true;
+  const uint32_t textures=be32(data);
+  if(textures>(size-8)/4) return true;
+  const size_t at=4+size_t(textures)*4;
+  const uint32_t count=be32(data+at);
+  if(count>(size-at-4)/4) return true;
+  const size_t table=at+4,body=table+size_t(count)*4;
+  size_t begin=0;
+  for(uint32_t i=0;i<count;++i) {
+    const size_t end=be32(data+table+size_t(i)*4);
+    if(end>size-body || end<begin || end-begin<4) return true;
+    if(be32(data+body+begin)&(1u<<14)) return true;
+    begin=end;
+  }
+  return false;
+}
+} // namespace PortShadowDemand
