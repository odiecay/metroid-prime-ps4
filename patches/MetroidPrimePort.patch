+  EXPECT_EQ(after.samples,before.samples+1);
+  EXPECT_EQ(after.untracked,before.untracked);
+  EXPECT_EQ(after.wait_ns-before.wait_ns,
+            after.queue_ns-before.queue_ns + after.service_ns-before.service_ns +
+            after.callback_ns-before.callback_ns + after.other_ns-before.other_ns);
+  EXPECT_GT(after.queue_ns,before.queue_ns);
+  EXPECT_GT(after.service_ns,before.service_ns);
+  EXPECT_GT(after.callback_ns,before.callback_ns);
+}
+
+TEST_F(DVDDiscTest, MandatoryReadBypassesBacklogAndPreservesBackgroundOrder) {
+  for(bool mandatory:{false,true}) {
+    MandatoryReadFixture f;
+    ASSERT_TRUE(f.Queue());
+    EXPECT_FALSE(aurora_dvd_prioritize_command(&f.files[0].cb)); // active read is never preempted
+    if(mandatory) EXPECT_TRUE(aurora_dvd_prioritize_command(&f.files.back().cb));
+    const auto start=std::chrono::steady_clock::now();
+    f.Release();
+    aurora_dvd_wait_command(&f.files.back().cb,mandatory);
+    const auto us=std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now()-start).count();
+    for(unsigned i=0;i<f.Count;++i) aurora_dvd_wait_command(&f.files[i].cb,false);
+    ASSERT_EQ(f.order.size(),f.Count);
+    EXPECT_EQ(f.order[0],0u);
+    EXPECT_EQ(f.order[mandatory?1:f.Count-1],f.Count-1);
+    unsigned expected=1;
+    for(unsigned id:f.order) if(id!=0 && id!=f.Count-1) EXPECT_EQ(id,expected++);
+    EXPECT_EQ(f.buffers.back().data[0],f.Count-1);
+    std::printf("DVD mandatory read: priority=%d backlog=%u complete_us=%lld (host worker only)\n",
+                int(mandatory),f.Count-2,static_cast<long long>(us));
+  }
+}
+
+TEST_F(DVDDiscTest, CancelledMandatoryReadDoesNotConsumeItsBuffer) {
+  MandatoryReadFixture f;ASSERT_TRUE(f.Queue());
+  ASSERT_TRUE(aurora_dvd_prioritize_command(&f.files.back().cb));
+  EXPECT_EQ(DVDCancel(&f.files.back().cb),DVD_RESULT_GOOD);
+  aurora_dvd_wait_command(&f.files.back().cb,true);
+  EXPECT_EQ(DVDGetCommandBlockStatus(&f.files.back().cb),DVD_STATE_CANCELED);
+  EXPECT_EQ(f.buffers.back().data[0],0);
+  f.Release();
+}
+
+TEST_F(DVDDiscTest, MandatoryAssetReadPreservesAudioPriority) {
+  MandatoryReadFixture f;ASSERT_TRUE(f.Queue(1));
+  ASSERT_TRUE(aurora_dvd_prioritize_command(&f.files.back().cb));
+  f.Release();
+  for(auto& file:f.files) aurora_dvd_wait_command(&file.cb,false);
+  ASSERT_EQ(f.order.size(),f.Count);
+  EXPECT_EQ(f.order[0],0u); // active read finishes first
+  EXPECT_EQ(f.order[1],1u); // music's existing priority stays ahead
+  EXPECT_EQ(f.order[2],f.Count-1); // required asset then bypasses only its background class
+}
