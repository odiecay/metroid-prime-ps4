+// Drive the production DVD worker through overlay reads. The first read is
+// held so the entire backlog is deterministic before a mandatory child read
+// is requested. No timing threshold is used to decide whether priority works.
+struct MandatoryReadFixture {
+  static constexpr unsigned Count=18;
+  struct Item { MandatoryReadFixture* owner{};unsigned id{}; };
+  std::mutex mutex;
+  std::condition_variable cv;
+  bool activeEntered=false,release=false,callbackEntered=false,releaseCallback=false;
+  std::vector<unsigned> order;
+  std::array<Item,Count> items;
+  std::array<std::string,Count> names;
+  std::array<DVDFileInfo,Count> files{};
+  struct alignas(32) Buffer { std::array<uint8_t,32> data{}; };
+  std::array<Buffer,Count> buffers;
+  unsigned opened=0;
+  MandatoryReadFixture() {
+    const AuroraOverlayCallbacks callbacks{
+      .open=[](void* p)->void* { return p; },.close=[](void*){},
+      .read=[](void* p,uint8_t* buf,size_t n)->int64_t {
+        const auto& item=*static_cast<Item*>(p);auto& owner=*item.owner;
+        {
+          std::unique_lock lock(owner.mutex);
+          if(item.id==0) {
+            owner.activeEntered=true;owner.cv.notify_all();
+            owner.cv.wait_for(lock,std::chrono::seconds(3),[&]{return owner.release;});
+          }
+          owner.order.push_back(item.id);
+        }
+        if(item.id>0 && item.id<Count-1) std::this_thread::sleep_for(std::chrono::milliseconds(2));
+        std::memset(buf,int(item.id),n);return int64_t(n);
+      },
+      .seek=[](void*,int64_t offset,int32_t)->int64_t { return offset; }
+    };
+    aurora_dvd_overlay_callbacks(&callbacks);
+    std::array<AuroraOverlayFile,Count> overlays;
+    for(unsigned i=0;i<Count;++i) {
+      items[i]={this,i};names[i]="/__mandatory_dvd__/"+std::to_string(i)+".bin";
+      overlays[i]={names[i].c_str(),&items[i],32};
+    }
+    aurora_dvd_overlay_files(overlays.data(),overlays.size(),nullptr);
+  }
+  ~MandatoryReadFixture() {
+    {std::lock_guard lock(mutex);release=true;releaseCallback=true;cv.notify_all();}
+    for(unsigned i=0;i<opened;++i) DVDClose(&files[i]);
+    aurora_dvd_overlay_files(nullptr,0,nullptr);
+  }
+  bool Queue(int audioPriorityId=-1) {
+    for(unsigned i=0;i<Count;++i) {
+      if(!DVDOpen(names[i].c_str(),&files[i])) return false;
+      ++opened;
+      if(!DVDReadAsyncPrio(&files[i],buffers[i].data.data(),32,0,nullptr,int(i)==audioPriorityId?1:2)) return false;
+      if(i==0) {
+        std::unique_lock lock(mutex);
+        if(!cv.wait_for(lock,std::chrono::seconds(2),[&]{return activeEntered;})) return false;
+      }
+    }
+    return true;
+  }
+  void Release() {std::lock_guard lock(mutex);release=true;cv.notify_all();}
+};
