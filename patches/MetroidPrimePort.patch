diff --git a/extern/aurora/lib/webgpu/readback_state.hpp b/extern/aurora/lib/webgpu/readback_state.hpp
new file mode 100644
index 00000000..56ebcab5
--- /dev/null
+++ b/extern/aurora/lib/webgpu/readback_state.hpp
@@ -0,0 +1,38 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <atomic>
+#include <cstdint>
+
+namespace aurora::webgpu::gpu_prof {
+enum class SlotState : uint8_t { Free, Recording, InFlight, Mapped, Failed };
+
+// A MapAsync callback may outlive the buffer/device teardown which aborts it.
+// Pair its expected state and epoch in one atomic compare/exchange so an old
+// callback cannot publish into a new use of the same static readback slot.
+class ReadbackState {
+  static constexpr uint64_t StateMask = 7;
+  std::atomic<uint64_t> m_value{0};
+public:
+  SlotState load(std::memory_order order = std::memory_order_acquire) const noexcept {
+    return SlotState(m_value.load(order) & StateMask);
+  }
+  operator SlotState() const noexcept { return load(); }
+  void store(SlotState state, std::memory_order order = std::memory_order_release) noexcept {
+    const auto epoch = m_value.load(std::memory_order_relaxed) & ~StateMask;
+    m_value.store(epoch | uint64_t(state), order);
+  }
+  ReadbackState& operator=(SlotState state) noexcept { store(state); return *this; }
+  // Owner thread only. Invalidates callbacks before releasing their resources.
+  void reset(SlotState state = SlotState::Free) noexcept {
+    const auto nextEpoch = (m_value.load(std::memory_order_relaxed) & ~StateMask) + StateMask + 1;
+    m_value.store(nextEpoch | uint64_t(state), std::memory_order_release);
+  }
+  uint64_t ticket() const noexcept { return m_value.load(std::memory_order_acquire) & ~StateMask; }
+  bool complete(uint64_t epoch, bool success) noexcept {
+    auto expected = epoch | uint64_t(SlotState::InFlight);
+    return m_value.compare_exchange_strong(expected,
+        epoch | uint64_t(success ? SlotState::Mapped : SlotState::Failed),
+        std::memory_order_release, std::memory_order_relaxed);
+  }
+};
+}
