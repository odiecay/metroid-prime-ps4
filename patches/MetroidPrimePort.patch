+    aurora::gfx::testing::arrayStorageCopies.clear();
+  }
+  // The production SetArraysCurrent + SetStaticArraysCurrent UV command
+  // sequences, decoded by the real command processor. Other GPU work is stubbed.
+  void BindStatic(const std::vector<u8>* uvs, bool reuse) {
+    if (!uvs || !reuse) {
+      GXSetArray(GX_VA_TEX7, nullptr, 0, 0, true);
+    } else {
+      GXSetArray(GX_VA_TEX7, uvs->data(), uvs->size(), 8, false);
+    }
+    if (uvs) {
+      for (int attr = GX_VA_TEX0; attr <= GX_VA_TEX7; ++attr)
+        GXSetArray(static_cast<GXAttr>(attr), uvs->data(), uvs->size(), 8, false);
+    }
+  }
+  void Draw(bool indexedPosition = false, bool indexedNormal = false) {
+    GXBegin(GX_TRIANGLES, GX_VTXFMT0, 3);
+    for (u8 i = 0; i < 3; ++i) {
+      if (indexedPosition) GXPosition1x8(i);
+      else GXPosition3u8(i, i + 1, i + 2);
+      if (indexedNormal) GXNormal1x8(i);
+      GXTexCoord1x8(i);
+    }
+    GXEnd();
+    aurora::gx::fifo::drain();
+  }
+  std::vector<u8> Uploaded(GXAttr attr) {
+    const u32 offset = aurora::gfx::g_testLastDraw.immediateData.arrayStart[attr - GX_VA_POS];
+    for (const auto& copy : aurora::gfx::testing::arrayStorageCopies)
+      if (copy.range.offset == offset) return copy.bytes;
+    ADD_FAILURE() << "draw references an uncaptured array range " << offset;
+    return {};
+  }
