+  const bool right = in.code == SDL_GAMEPAD_AXIS_RIGHTX || in.code == SDL_GAMEPAD_AXIS_RIGHTY;
+  if (!left && !right) return {};
+  std::string stem = std::string(device) + (left ? "_stick_l" : "_stick_r");
+  if (whole || in.dir == 0) return stem;
+  const bool vertical = in.code == SDL_GAMEPAD_AXIS_LEFTY || in.code == SDL_GAMEPAD_AXIS_RIGHTY;
+  return stem + (vertical ? (in.dir > 0 ? "_down" : "_up") : (in.dir > 0 ? "_right" : "_left"));
+}
