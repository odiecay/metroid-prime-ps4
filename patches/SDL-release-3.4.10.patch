diff --git a/src/video/dummy/SDL_nullvideo.c b/src/video/dummy/SDL_nullvideo.c
index 58063e2..4d3b651 100644
--- a/src/video/dummy/SDL_nullvideo.c
+++ b/src/video/dummy/SDL_nullvideo.c
@@ -183,8 +183,15 @@ bool DUMMY_VideoInitCommon(SDL_VideoDevice *_this)
     // Use a fake 32-bpp desktop mode
     SDL_zero(mode);
     mode.format = SDL_PIXELFORMAT_XRGB8888;
+#ifdef __ORBIS__
+    // Logical window geometry only; native Vulkan WSI owns the actual display.
+    mode.w = 1920;
+    mode.h = 1080;
+    mode.refresh_rate = 60.0f;
+#else
     mode.w = 1024;
     mode.h = 768;
+#endif
     if (SDL_AddBasicVideoDisplay(&mode) == 0) {
         return false;
     }
