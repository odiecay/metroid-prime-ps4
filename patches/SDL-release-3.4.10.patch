diff --git a/CMakeLists.txt b/CMakeLists.txt
index faf6d90..451edc3 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -382,7 +382,7 @@ dep_option(SDL_HIDAPI              "Enable the HIDAPI subsystem" ON "NOT VISIONO
 dep_option(SDL_HIDAPI_LIBUSB       "Use libusb for low level joystick drivers" ON "SDL_HIDAPI;SDL_HIDAPI_LIBUSB_AVAILABLE" OFF)
 dep_option(SDL_HIDAPI_LIBUSB_SHARED "Dynamically load libusb support" ON "SDL_HIDAPI_LIBUSB;SDL_DEPS_SHARED" OFF)
 dep_option(SDL_HIDAPI_JOYSTICK     "Use HIDAPI for low level joystick drivers" ON SDL_HIDAPI OFF)
-dep_option(SDL_VIRTUAL_JOYSTICK    "Enable the virtual-joystick driver" ON SDL_HIDAPI OFF)
+dep_option(SDL_VIRTUAL_JOYSTICK    "Enable the virtual-joystick driver" ON SDL_JOYSTICK OFF)
 set_option(SDL_LIBUDEV             "Enable libudev support" ON)
 set_option(SDL_ASAN                "Use AddressSanitizer to detect memory errors" OFF)
 set_option(SDL_CCACHE              "Use Ccache to speed up build" OFF)
@@ -1771,6 +1771,33 @@ elseif(EMSCRIPTEN)
   CheckPTHREAD()
   CheckLibUnwind()
 
+elseif(PS4)
+  # Project Prime native Orbis integration. The platform sources are owned by
+  # the consumer; no Linux display/audio/input drivers are selected.
+  if(NOT SDL_PRIME_PLATFORM_DIR)
+    message(FATAL_ERROR "Orbis needs SDL_PRIME_PLATFORM_DIR")
+  endif()
+  if(SDL_AUDIO)
+    set(SDL_AUDIO_DRIVER_ORBIS 1)
+    sdl_sources("${SDL_PRIME_PLATFORM_DIR}/SDL_orbisaudio.c")
+    set(HAVE_SDL_AUDIO TRUE)
+    sdl_link_dependency(orbis_audio LIBS SceAudioOut)
+  endif()
+  set(SDL_PTHREADS_PRIVATE ON)
+  CheckPTHREAD()
+  set(SDL_TIME_UNIX 1)
+  sdl_glob_sources("${SDL3_SOURCE_DIR}/src/time/unix/*.c")
+  set(HAVE_SDL_TIME TRUE)
+  set(SDL_TIMER_UNIX 1)
+  sdl_glob_sources("${SDL3_SOURCE_DIR}/src/timer/unix/*.c")
+  set(HAVE_SDL_TIMERS TRUE)
+  sdl_sources("${SDL_PRIME_PLATFORM_DIR}/SDL_orbisfilesystem.c")
+  set(HAVE_SDL_FILESYSTEM TRUE)
+  set(SDL_FSOPS_POSIX 1)
+  sdl_sources("${SDL3_SOURCE_DIR}/src/filesystem/posix/SDL_sysfsops.c")
+  set(HAVE_SDL_FSOPS TRUE)
+  sdl_include_directories(PRIVATE "${SDL3_SOURCE_DIR}/src")
+
 elseif(UNIX AND NOT APPLE AND NOT RISCOS AND NOT HAIKU)
 
   set(SDL_DISABLE_DLOPEN_NOTES TRUE)
