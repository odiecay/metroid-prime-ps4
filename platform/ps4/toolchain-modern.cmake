include("${CMAKE_CURRENT_LIST_DIR}/toolchain-runtime.cmake")
if(NOT PRIME_CXX_PREFIX)
  get_filename_component(PRIME_CXX_PREFIX "${CMAKE_CURRENT_LIST_DIR}/../../build/modern-runtime" ABSOLUTE)
endif()
set(PRIME_CXX_PREFIX "${PRIME_CXX_PREFIX}" CACHE PATH "Project-local native libc++19 prefix")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES PRIME_CXX_PREFIX)
if(NOT EXISTS "${PRIME_CXX_PREFIX}/include/c++/v1/__config_site")
  message(FATAL_ERROR "Run tools/build_runtime.py before using the modern Orbis toolchain")
endif()
string(PREPEND CMAKE_CXX_FLAGS_INIT "-isystem ${PRIME_CXX_PREFIX}/include/c++/v1 ")
string(PREPEND CMAKE_C_FLAGS_INIT "-isystem ${CMAKE_CURRENT_LIST_DIR}/compat ")
string(PREPEND CMAKE_CXX_FLAGS_INIT "-isystem ${CMAKE_CURRENT_LIST_DIR}/compat ")
string(APPEND CMAKE_CXX_FLAGS_INIT " -fexperimental-library")
string(PREPEND CMAKE_EXE_LINKER_FLAGS_INIT "-L${PRIME_CXX_PREFIX}/lib ")
set(CMAKE_CXX_STANDARD_LIBRARIES "-lc++ -lc++experimental -lc++abi -lunwind -lc -lkernel ${ORBIS_CRT1}")
